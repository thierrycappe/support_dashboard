# Production/Vercel must use the PostgreSQL provider's pooled endpoint. Do not
# enable transaction-backed service routes with a direct single-session URL.
DATABASE_URL=
# Maximum node-postgres connections per runtime instance. Keep the total across
# concurrent instances within the provider/project connection budget.
DATABASE_POOL_MAX=5
AUTH_SECRET=
AUTH_TRUST_HOST=true
SUPPORT_DASHBOARD_ADMIN_EMAILS=
SUPPORT_DASHBOARD_ADMIN_PASSWORD_HASH=
# Development-only fallback. Production requires SUPPORT_DASHBOARD_ADMIN_PASSWORD_HASH.
SUPPORT_DASHBOARD_ADMIN_PASSWORD=
# Legacy compatibility only. New apps use administrator-approved public-key
# enrollment. A legacy slug resolves one independently rotatable token; the slug
# is normalized (uppercase, non-alphanumeric -> _), e.g. "pichon-bi-feedback"
# reads SUPPORT_TOWER_INGEST_TOKEN_PICHON_BI_FEEDBACK.
# Generate with: openssl rand -hex 32
SUPPORT_TOWER_INGEST_TOKEN_CSM=
SUPPORT_TOWER_INGEST_TOKEN_CASAL_TRACK=
SUPPORT_TOWER_INGEST_TOKEN_PITCHME=
SUPPORT_TOWER_INGEST_TOKEN_PICHON_BI_FEEDBACK=
# Optional public source app URL overrides used to rewrite localhost deep links.
SUPPORT_TOWER_SOURCE_APP_URLS_JSON={"pitchme":"https://pitchme-pearl.vercel.app"}
# Canonical public HTTPS origin with no path, query, or fragment. Required by
# public-key enrollment/token metadata and used for authenticated portal links.
SUPPORT_TOWER_PUBLIC_URL=
# Legacy central Pushover bridge. Database-backed channels are configured in
# the authenticated portal and encrypted with the keyring below.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Versioned AES-256-GCM envelope keys for DATABASE notification channels.
# Use base64-encoded 32-byte keys and keep prior versions while rows still use
# them, for example: {"active":"v1","keys":{"v1":"replace-with-base64-32-byte-key"}}
SUPPORT_TOWER_CHANNEL_ENCRYPTION_KEYS_JSON=
# Ed25519 private JWK used only to sign short-lived service access tokens.
# Generate with: npm run auth:generate-service-signing-key
SUPPORT_TOWER_ACCESS_TOKEN_PRIVATE_JWK=
# Optional Resend email digest for the daily open-ticket report.
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_TOWER_DIGEST_EMAIL_TO=
# Required in production for Vercel Cron authorization. The delivery cron runs
# every minute. Worker behavior is intentionally fixed in code rather than env:
# concurrency 20, 60-second renewable leases, 100-job batches, at most 500 jobs
# started, and a 45-second immediate-drain budget.
CRON_SECRET=
# Optional outbound pull configuration. Maps a source app slug to an HTTPS
# endpoint and bearer token. Requests reject credentials/custom ports,
# private/special-use DNS answers, and redirects; validated DNS is pinned. Each
# response has a fixed 15-second deadline, 1 MiB streamed-body cap, and 500-ticket cap.
# The endpoint must accept GET <url> and GET <url>?externalId=<id>, returning
# { "tickets": FeedbackIngestPayload[] }. Used by /api/cron/sync-source-apps and the per-ticket
# "Refresh from source" button.
SUPPORT_TOWER_SOURCE_APP_PULL_JSON={"casal-track":{"url":"https://casal-track.example.com/api/support-tower/export","token":"replace-me"}}

# Verification only. The integration URL must name a *_test database and carry
# support_test=1. The Playwright/load origins must point to disposable local or
# test deployments. Production-looking load targets are refused unless the
# operator explicitly sets ALLOW_SUPPORT_LOAD_TEST=1.
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/support_tower_test?support_test=1
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
LOAD_TEST_BASE_URL=http://127.0.0.1:3000
LOAD_TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/support_tower_test?support_test=1
LOAD_TEST_APP_ID=
LOAD_TEST_CREDENTIAL_ID=
LOAD_TEST_PRIVATE_JWK=
ALLOW_SUPPORT_LOAD_TEST=0
# Optional bounded harness controls. Defaults: concurrency 20, deadline 8 min,
# 30 throttled retries, and 65 s delivery polling. RUN_ID is generated unless
# supplied and accepts only cleanup-safe letters, digits, and dashes.
LOAD_TEST_CONCURRENCY=20
LOAD_TEST_DEADLINE_MS=480000
LOAD_TEST_MAX_RETRIES=30
LOAD_TEST_DELIVERY_WAIT_MS=65000
LOAD_TEST_RUN_ID=
